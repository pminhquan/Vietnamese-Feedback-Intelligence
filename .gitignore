# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Environment / secrets ---
.env
.env.*
*.key

# --- Local datasets: NEVER commit raw or processed data ---
data/raw/
data/processed/
data/external/
data/*.csv
data/*.tsv
data/*.jsonl
data/*.parquet
data/*.zip
!data/README.md

# --- Model artifacts / experiment outputs (root-anchored) ---
# Lesson learned: these patterns MUST stay root-anchored - an unanchored
# `models/` once shadowed the src/vfi/models/ package from git AND ruff.
/models/
/reports/artifacts/
*.joblib
*.pkl
*.safetensors

# --- Model weights / checkpoints (torch-era formats, risk R-08) ---
*.bin
*.pt
*.ckpt
*.onnx
*.h5

# --- Independent dataset stores (custom dataset builder output) ---
data/datasets/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
